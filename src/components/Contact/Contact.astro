---
import profile from '@/data/profile.json';
import Icon from '@/components/Icon/Icon.astro';

const icons: Record<string, string> = {
  GitHub: 'github',
  LinkedIn: 'linkedin',
  X: 'x',
  'dev.to': 'devdotto',
  Telegram: 'telegram',
  LeetCode: 'leetcode',
  Codeforces: 'codeforces',
};
---

<div class="contact blk">
  <span class="plus p1" aria-hidden="true"></span>
  <span class="plus p2" aria-hidden="true"></span>
  <p class="mono where"><span class="dot ok"></span> Bhubaneswar, India (UTC+5:30)</p>
  <h3 class="display">Building an agent, a RAG pipeline, or something that has to stay up? Tell me about it.</h3>
  <p class="muted lede">
    I'm happiest on the backend of AI products: retrieval, agent orchestration, queues and the reliability work around them.
  </p>

  <div class="row">
    <details class="dd" data-dd>
      <summary class="btn solid">
        Get in touch
        <svg class="chev" viewBox="0 0 12 12" width="11" height="11" aria-hidden="true">
          <path d="M2 4.5 6 8.5 10 4.5" fill="none" stroke="currentColor" stroke-width="1.6"></path>
        </svg>
      </summary>
      <ul class="menu">
        <li>
          <a href={`mailto:${profile.email}`}>
            <Icon name="mail" size={16} />
            <span>Email</span>
            <span class="mono h">{profile.email}</span>
          </a>
        </li>
        {
          profile.links.map((l) => (
            <li>
              <a href={l.href} target="_blank" rel="noopener">
                <Icon name={icons[l.label] ?? 'external'} size={16} />
                <span>{l.label}</span>
                <span class="mono h">{l.handle}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </details>
    <button class="btn copy" type="button" data-copy={profile.email}>
      <span class="addr">{profile.email}</span>
      <span class="mono status" aria-live="polite">Copy</span>
    </button>
    <a class="btn" href={profile.resume} target="_blank" rel="noopener">Résumé ↗</a>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('button[data-copy]').forEach((b) => {
    const status = b.querySelector('.status')!;
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copy!);
        status.textContent = 'Copied';
      } catch {
        status.textContent = 'Select it instead';
      }
      setTimeout(() => (status.textContent = 'Copy'), 2000);
    });
  });

  // Close the dropdown on outside click or Escape.
  document.querySelectorAll<HTMLDetailsElement>('[data-dd]').forEach((dd) => {
    document.addEventListener('click', (e) => {
      if (dd.open && !dd.contains(e.target as Node)) dd.open = false;
    });
    dd.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && dd.open) {
        dd.open = false;
        dd.querySelector('summary')!.focus();
      }
    });
  });
</script>

<style>
  .contact {
    padding: clamp(1.5rem, 4vw, 3rem);
  }
  .p1 {
    top: -8px;
    left: -8px;
  }
  .p2 {
    bottom: -8px;
    right: -8px;
  }
  .where {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1.4rem;
    color: var(--muted);
  }
  h3 {
    max-width: 18ch;
    margin: 0;
    font-size: clamp(2.2rem, 5.5vw, 4rem);
    line-height: 0.92;
  }
  .lede {
    max-width: 34rem;
    margin: 1.2rem 0 2rem;
    font-size: 1.05rem;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .dd {
    position: relative;
  }
  summary {
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .chev {
    transition: rotate 0.2s var(--ease);
  }
  .dd[open] .chev {
    rotate: 180deg;
  }
  .menu {
    position: absolute;
    z-index: 20;
    bottom: calc(100% + 6px); /* opens upward: this block is the last thing on the page */
    left: 0;
    min-width: 21rem;
    margin: 0;
    padding: 0.35rem 0;
    list-style: none;
    background: var(--panel);
    border: 1px solid var(--fg);
    box-shadow: 6px 6px 0 var(--fg);
  }
  .menu a {
    display: grid;
    grid-template-columns: 1.2rem 6rem 1fr;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.9rem;
    font-size: 0.92rem;
    font-weight: 500;
  }
  .menu a:hover,
  .menu a:focus-visible {
    background: var(--accent);
    color: var(--accent-ink);
    outline: none;
  }
  .h {
    color: var(--faint);
    text-align: right;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .menu a:hover .h,
  .menu a:focus-visible .h {
    color: inherit;
  }
  .copy {
    gap: 0.8rem;
  }
  .status {
    padding-left: 0.8rem;
    border-left: 1px solid currentColor;
    font-weight: 400;
  }
  @media (max-width: 560px) {
    .menu {
      min-width: 0;
      width: calc(100vw - 2 * var(--gutter) - 3rem);
    }
    .addr {
      max-width: 13rem;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }
</style>
