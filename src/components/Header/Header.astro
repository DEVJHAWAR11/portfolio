---
import profile from '@/data/profile.json';
import Secrets from '@/components/Secrets/Secrets.astro';

const home = /^\/(index\.html)?$/.test(Astro.url.pathname);

const nav = [
  { href: '/#projects', label: 'Projects' },
  { href: '/#open-source', label: 'Open source' },
  { href: '/#writing', label: 'Writing' },
  { href: '/#contact', label: 'Contact' },
];

// Accent colours a visitor can pick; the values live in global.css, these are only the swatches.
const accents = [
  { id: 'blue', label: 'Blue', light: '#2b37e6', dark: '#7d87ff' },
  { id: 'violet', label: 'Violet', light: '#6b2fd6', dark: '#b48cff' },
  { id: 'rose', label: 'Rose', light: '#c4234f', dark: '#ff7a9c' },
  { id: 'amber', label: 'Amber', light: '#9a4d00', dark: '#ffb547' },
  { id: 'teal', label: 'Teal', light: '#08705f', dark: '#3fd0bf' },
];
---

<header class="bar" data-noprint data-step>
  <div class="inner">
    <a href="/" class="mark">
      <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
        <rect x="1" y="1" width="22" height="22" fill="var(--fg)" />
        <rect x="12" y="12" width="11" height="11" fill="var(--accent)" />
      </svg>
      <span class="who">
        <span>{profile.name}<span class="sr-only">, home</span></span>
        {home && <small class="hint mono" id="hint" aria-hidden="true">click me</small>}
      </span>
    </a>
    {home && <Secrets />}
    <nav aria-label="Sections">
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    </nav>
    <div class="right">
      <button class="find" type="button" data-palette aria-label="Search the site" aria-keyshortcuts="Control+K Meta+K">
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
          <circle cx="7" cy="7" r="5" fill="none" stroke="currentColor" stroke-width="1.5" />
          <path d="m11 11 3.5 3.5" stroke="currentColor" stroke-width="1.5" />
        </svg>
        <span class="lbl">Search</span>
        <kbd class="mono" id="find-key">Ctrl K</kbd>
      </button>
      <button class="sq" id="accent-btn" type="button" popovertarget="accents" aria-label="Choose an accent colour">
        <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
          {accents.slice(0, 4).map((a, i) => (
            <rect x={i % 2 ? 8.5 : 1.5} y={i < 2 ? 1.5 : 8.5} width="6" height="6" style={`--c:${a.light};--cd:${a.dark}`} />
          ))}
        </svg>
      </button>
      <div class="accents" id="accents" popover aria-label="Accent colour">
        {accents.map((a) => (
          <button type="button" data-accent-pick={a.id} aria-label={a.label} title={a.label} aria-pressed="false" style={`--c:${a.light};--cd:${a.dark}`} />
        ))}
      </div>
      <a class="btn solid sm" href={profile.resume} target="_blank" rel="noopener">Résumé ↗</a>
      <div class="lamp" id="lamp">
        <button id="theme-toggle" type="button" aria-label="Switch to dark theme"></button>
        <!-- What you grab: the knob's spot, but bigger, and an HTML box so touch-action stops a drag from scrolling. -->
        <span class="grip" aria-hidden="true"></span>
        <!-- A pendant lamp hung from the top of the header, with a pull cord: lit for light, off for dark. -->
        <svg class="rig" viewBox="-80 0 160 480" width="160" height="480" aria-hidden="true">
          <defs>
            <radialGradient id="lamp-glow">
              <stop offset="0" stop-color="#ffc45c" stop-opacity="0.6" />
              <stop offset="0.35" stop-color="#ffc45c" stop-opacity="0.25" />
              <stop offset="1" stop-color="#ffc45c" stop-opacity="0" />
            </radialGradient>
            <!-- Brushed metal, lit from the upper left. The stop colours change with the theme (below). -->
            <linearGradient id="lamp-metal" x1="0" x2="1">
              <stop offset="0" class="m0" />
              <stop offset="0.28" class="m1" />
              <stop offset="0.62" class="m2" />
              <stop offset="1" class="m3" />
            </linearGradient>
            <radialGradient id="lamp-in" cy="0.15" r="0.95">
              <stop offset="0" stop-color="#fffbea" />
              <stop offset="0.45" stop-color="#ffd27a" />
              <stop offset="1" stop-color="#e8892a" />
            </radialGradient>
            <radialGradient id="lamp-bulb" cx="0.45" cy="0.4" r="0.7">
              <stop offset="0" stop-color="#fff" />
              <stop offset="0.5" stop-color="#ffeaa8" />
              <stop offset="1" stop-color="#ffb13d" />
            </radialGradient>
            <radialGradient id="lamp-glass" cx="0.38" cy="0.32" r="0.75">
              <stop offset="0" stop-color="#9aa0a9" />
              <stop offset="1" stop-color="#2c3036" />
            </radialGradient>
            <radialGradient id="lamp-bead" cx="0.35" cy="0.3" r="0.75">
              <stop offset="0" stop-color="#ffe6b0" />
              <stop offset="0.5" stop-color="#e39a35" />
              <stop offset="1" stop-color="#8f5410" />
            </radialGradient>
          </defs>
          <path class="wire" d="M0 0V13" />
          <g class="head">
            <circle class="glow" cx="0" cy="35" r="46" fill="url(#lamp-glow)" />
            <rect x="-2.6" y="11.5" width="5.2" height="6" rx="1.2" fill="url(#lamp-metal)" />
            <path d="M0 16C-7 16-10.2 21-12 32h24C10.2 21 7 16 0 16Z" fill="url(#lamp-metal)" />
            <path class="sheen" d="M-3.8 18.3C-6.6 19.8-8.3 23.5-9.5 29" />
            <ellipse class="mouth" cx="0" cy="32" rx="12" ry="2.4" />
            <circle class="bulb" cx="0" cy="33.4" r="3.7" />
            <ellipse class="spec" cx="-1.3" cy="32.2" rx="1.1" ry="0.75" />
          </g>
          <path class="cord" d="M0 37V67" />
          <g class="knob" transform="translate(0 67)">
            <rect class="crimp" x="-1.1" y="-1.5" width="2.2" height="2.6" rx="0.6" />
            <circle class="bead" cx="0" cy="4.4" r="4.2" />
          </g>
          <g class="piece" style="display: none">
            <path />
            <circle class="bead" cx="0" cy="4.4" r="4.2" />
          </g>
        </svg>
      </div>
    </div>
  </div>
</header>

<script>
  import { sfx } from '@/lib/sfx';
  import { lamp } from '@/lib/lamp';

  if (/Mac|iPhone|iPad/.test(navigator.platform)) document.getElementById('find-key')!.textContent = '⌘K';

  // On the home page the logo scrolls to the top, and five quick clicks open the secrets console.
  const mark = document.querySelector<HTMLAnchorElement>('.mark')!;
  const hint = document.getElementById('hint');
  const NEED = 5;
  let clicks = 0;
  let last = 0;
  let reset = 0;
  mark.addEventListener('click', (e) => {
    if (!hint) return;
    e.preventDefault();
    const now = performance.now();
    clicks = now - last < 1500 ? clicks + 1 : 1;
    last = now;
    window.scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    clearTimeout(reset);
    if (clicks >= NEED) {
      clicks = 0;
      hint.textContent = 'click me';
      document.dispatchEvent(new CustomEvent('secrets', { detail: mark }));
      return;
    }
    sfx.tick(clicks - 1);
    hint.textContent = clicks === 1 ? 'keep going' : `${NEED - clicks} more`;
    reset = window.setTimeout(() => (hint.textContent = 'click me'), 1500);
  });

  const root = document.documentElement;
  const btn = document.getElementById('theme-toggle') as HTMLButtonElement;
  const sync = () => btn.setAttribute('aria-label', root.dataset.theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
  sync();
  // The theme is a lamp with a pull cord, and pulled too far the cord snaps; see src/lib/lamp.ts. Switching on, the
  // light spreads out of the bulb over the page; switching off, it shrinks back into it.
  lamp(document.getElementById('lamp')!, ({ x, y }) => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    sfx.toggle();
    const apply = () => {
      root.dataset.theme = next;
      sync();
    };
    const vt = (document as any).startViewTransition;
    if (vt && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      root.dataset.vt = next;
      const t = vt.call(document, apply);
      t.ready
        .then(() => {
          const r = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
          const light = [`circle(0px at ${x}px ${y}px)`, `circle(${r}px at ${x}px ${y}px)`];
          const reveal = root.animate(
            { clipPath: next === 'light' ? light : light.reverse() },
            { duration: 600, easing: 'cubic-bezier(0.55, 0, 0.2, 1)', fill: 'forwards', pseudoElement: `::view-transition-${next === 'light' ? 'new' : 'old'}(root)` },
          );
          // Held at its end until the transition is over, then dropped, or the next one would start clipped.
          t.finished.finally(() => reveal.cancel());
        })
        .catch(() => {});
      t.finished.finally(() => delete root.dataset.vt);
    } else apply();
    try {
      localStorage.setItem('theme-v2', next);
    } catch {}
  });

  // Accent picker: a small popover under its button. The choice is saved, and the head script applies it before paint.
  const accentBtn = document.getElementById('accent-btn')!;
  const accents = document.getElementById('accents')!;
  const picks = [...accents.querySelectorAll<HTMLButtonElement>('[data-accent-pick]')];
  const syncAccent = () =>
    picks.forEach((b) => b.setAttribute('aria-pressed', String((root.dataset.accent || 'blue') === b.dataset.accentPick)));
  syncAccent();
  accents.addEventListener('beforetoggle', (e) => {
    if ((e as ToggleEvent).newState !== 'open') return;
    const r = accentBtn.getBoundingClientRect();
    accents.style.top = `${r.bottom + 8}px`;
    accents.style.right = `${Math.max(8, innerWidth - r.right)}px`;
  });
  picks.forEach((b, i) =>
    b.addEventListener('click', () => {
      const id = b.dataset.accentPick!;
      if (id === 'blue') delete root.dataset.accent;
      else root.dataset.accent = id;
      try {
        if (id === 'blue') localStorage.removeItem('accent');
        else localStorage.setItem('accent', id);
      } catch {}
      sfx.tick(i);
      syncAccent();
    }),
  );
</script>

<style>
  .bar {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--edge);
  }
  .inner {
    width: min(var(--w), 100% - 2 * var(--gutter));
    height: 3.75rem;
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    position: relative;
  }
  .mark {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font: 800 1.15rem/1 var(--display);
    font-stretch: 80%;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .who {
    display: grid;
  }
  .hint {
    margin-top: 0.2rem;
    font: 500 0.58rem/1 var(--mono);
    font-stretch: normal;
    letter-spacing: 0.02em;
    color: var(--faint);
    transition: color 0.15s;
  }
  .mark:hover .hint {
    color: var(--accent);
  }
  nav {
    display: flex;
    gap: 2rem;
    font-size: 0.92rem;
    font-weight: 500;
  }
  nav a {
    white-space: nowrap;
    padding-block: 0.3rem;
    background: linear-gradient(var(--accent), var(--accent)) 0 100% / 0 2px no-repeat;
    transition: background-size 0.25s var(--ease), color 0.15s;
  }
  nav a:hover {
    color: var(--accent);
    background-size: 100% 2px;
  }
  .right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .find {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    height: 2.2rem;
    padding: 0 0.5rem 0 0.7rem;
    border: 1px solid var(--edge);
    background: var(--panel);
    color: var(--muted);
    font-size: 0.85rem;
    transition: border-color 0.15s, color 0.15s;
  }
  .find:hover {
    border-color: var(--fg);
    color: var(--fg);
  }
  .find kbd {
    padding: 0.05rem 0.3rem;
    border: 1px solid var(--edge);
    font-size: 0.68rem;
  }
  .lbl {
    margin-right: 1.2rem;
  }
  .sq {
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border: 1px solid var(--edge);
    background: var(--panel);
    transition: border-color 0.15s, color 0.15s;
  }
  .sq:hover {
    border-color: var(--fg);
  }
  /* The theme switch: a lamp hung from the top of the header, drawn past its own slot (src/lib/lamp.ts). */
  .lamp {
    --slot: 2.2rem;
    position: relative;
    margin-left: 0.6rem;
    width: var(--slot);
    height: var(--slot);
  }
  #theme-toggle {
    width: 100%;
    height: 100%;
    background: none;
  }
  .rig {
    position: absolute;
    top: calc((var(--slot) - 3.75rem) / 2); /* the top of the header */
    left: 50%;
    width: 160px;
    max-width: none;
    height: 480px;
    margin-left: -80px;
    overflow: visible;
    pointer-events: none;
    will-change: transform; /* its own layer, so a swinging lamp doesn't repaint the blurred header */
  }
  .wire,
  .cord,
  .piece path {
    fill: none;
    stroke-linecap: round;
  }
  .wire {
    stroke: var(--fg);
    stroke-width: 1.2;
    opacity: 0.6;
  }
  /* A brass chain cord with a bead on the end. */
  .cord,
  .piece path {
    --brass: #b57722;
    stroke: var(--brass);
    stroke-width: 1.6;
  }
  .cord.taut {
    stroke: var(--accent);
  }
  .bead {
    fill: url(#lamp-bead);
  }
  .crimp {
    fill: url(#lamp-metal);
  }
  /* Dark steel on the light page; white enamel on the dark one. */
  .m0 {
    stop-color: #16181c;
  }
  .m1 {
    stop-color: #6c727c;
  }
  .m2 {
    stop-color: #2b2f36;
  }
  .m3 {
    stop-color: #0c0d10;
  }
  :global([data-theme='dark']) .m0 {
    stop-color: #c4cad3;
  }
  :global([data-theme='dark']) .m1 {
    stop-color: #ffffff;
  }
  :global([data-theme='dark']) .m2 {
    stop-color: #e8ebef;
  }
  :global([data-theme='dark']) .m3 {
    stop-color: #9aa1ab;
  }
  .sheen {
    fill: none;
    stroke: #fff;
    stroke-width: 0.8;
    stroke-linecap: round;
    opacity: 0.35;
  }
  .mouth {
    fill: url(#lamp-in);
  }
  .bulb {
    fill: url(#lamp-bulb);
  }
  .spec {
    fill: #fff;
    opacity: 0.9;
  }
  .glow {
    transition: opacity 0.3s;
  }
  /* Lights off: a dark inside, a grey glass bulb with a glint, no glow. */
  :global([data-theme='dark']) .mouth {
    fill: #121418;
  }
  :global([data-theme='dark']) .bulb {
    fill: url(#lamp-glass);
  }
  :global([data-theme='dark']) .spec {
    opacity: 0.55;
  }
  :global([data-theme='dark']) .glow {
    opacity: 0;
  }
  :global([data-theme='dark']) .cord,
  :global([data-theme='dark']) .piece path {
    --brass: #d39a4c;
  }
  .knob .bead {
    transform-box: fill-box;
    transform-origin: 50% 0;
    transition: scale 0.15s var(--ease);
  }
  /* Centred on the knob at rest; the script moves it with the knob. */
  .grip {
    position: absolute;
    z-index: 1;
    top: calc((var(--slot) - 3.75rem) / 2 + 71px - 22px);
    left: calc(50% - 22px);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    cursor: grab;
    touch-action: none;
  }
  .grip:hover + .rig .knob .bead,
  .pulling .knob .bead {
    scale: 1.25;
  }
  .pulling .grip {
    cursor: grabbing;
  }
  /* The cord snapping: two flickers of the bulb in half a second. */
  .flicker :is(.bulb, .mouth, .glow) {
    animation: flicker 0.5s steps(1);
  }
  @keyframes flicker {
    0%,
    50% {
      opacity: 0.15;
    }
    25%,
    75% {
      opacity: 1;
    }
  }
  #accent-btn rect,
  .accents button {
    fill: var(--c);
    background: var(--c);
  }
  :global([data-theme='dark']) #accent-btn rect,
  :global([data-theme='dark']) .accents button {
    fill: var(--cd);
    background: var(--cd);
  }
  .accents {
    position: fixed;
    inset: auto;
    margin: 0;
    padding: 0.5rem;
    border: 1px solid var(--fg);
    background: var(--panel);
    box-shadow: 5px 5px 0 color-mix(in srgb, var(--fg) 12%, transparent);
    gap: 0.45rem;
  }
  .accents:popover-open {
    display: flex;
  }
  .accents button {
    width: 1.75rem;
    height: 1.75rem;
    transition: scale 0.15s var(--ease);
  }
  .accents button:hover {
    scale: 1.1;
  }
  .accents button[aria-pressed='true'] {
    outline: 2px solid var(--fg);
    outline-offset: 2px;
  }
  @media (max-width: 900px) {
    nav {
      display: none;
    }
  }
  @media (max-width: 1100px) {
    .lbl {
      display: none;
    }
  }
  @media (max-width: 480px) {
    .find kbd {
      display: none;
    }
    /* Four controls and the name have to share a 375px phone. */
    .right {
      gap: 0.3rem;
    }
    .lamp {
      --slot: 2rem;
      margin-left: 0.15rem;
    }
    .find,
    .sq {
      width: 2rem;
      height: 2rem;
      padding: 0;
      justify-content: center;
    }
    .right .btn.sm {
      padding: 0 0.6rem;
    }
  }
</style>
