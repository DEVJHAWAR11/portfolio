---
// My photo as halftone dots (built by /halftone.svg). The dots are a CSS mask, so they take the theme's colours.
// A warm copy shows through a circle that follows the cursor, or moves to where you tap on a phone.
---

<div class="portrait" data-portrait role="img" aria-label="Portrait of Dev Jhawar, drawn in dots">
  <div class="layer ink"></div>
  <div class="layer hot"></div>
  <span class="plus a" aria-hidden="true"></span>
  <span class="plus b" aria-hidden="true"></span>
  <span class="mono note n1" aria-hidden="true">Agents<br />Retrieval<br />Backend</span>
  <span class="mono note n2" aria-hidden="true">Plan<br />Search<br />Cite<br />Ship</span>
</div>

<script>
  const el = document.querySelector<HTMLElement>('[data-portrait]');
  if (el) {
    const moveTo = (e: { clientX: number; clientY: number }) => {
      const r = el.getBoundingClientRect();
      el.style.setProperty('--x', `${((e.clientX - r.left) / r.width) * 100}%`);
      el.style.setProperty('--y', `${((e.clientY - r.top) / r.height) * 100}%`);
    };
    if (matchMedia('(hover: hover)').matches) {
      let raf = 0;
      el.addEventListener('pointermove', (e) => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => moveTo(e));
      });
      el.addEventListener('pointerleave', () => {
        el.style.removeProperty('--x');
        el.style.removeProperty('--y');
      });
    } else {
      // On a phone the circle glides to wherever you tap. It only listens for taps, so scrolling over the photo works as usual.
      el.classList.add('tap');
      el.addEventListener('click', moveTo);
    }
  }
</script>

<style>
  /* Registered so a tap can animate the circle's position. */
  @property --x {
    syntax: '<percentage>';
    inherits: true;
    initial-value: 70%;
  }
  @property --y {
    syntax: '<percentage>';
    inherits: true;
    initial-value: 84%;
  }
  .portrait.tap {
    transition: --x 0.45s var(--ease), --y 0.45s var(--ease);
  }
  @media (prefers-reduced-motion: reduce) {
    .portrait.tap {
      transition: none;
    }
  }
  .portrait {
    position: relative;
    aspect-ratio: 1;
    --sun: linear-gradient(150deg, #f29a12 10%, #e2365b 90%);
  }
  :global([data-theme='dark']) .portrait {
    --sun: linear-gradient(150deg, #ffc35a 10%, #ff5d7a 90%);
  }
  .layer {
    position: absolute;
    inset: 0;
    -webkit-mask: url('/halftone.svg') center / contain no-repeat;
    mask: url('/halftone.svg') center / contain no-repeat;
  }
  .ink {
    background: var(--fg);
  }
  .hot {
    background: var(--sun);
    -webkit-mask-image: url('/halftone.svg'), radial-gradient(circle at var(--x, 70%) var(--y, 84%), #000 15%, transparent 15.3%);
    mask-image: url('/halftone.svg'), radial-gradient(circle at var(--x, 70%) var(--y, 84%), #000 15%, transparent 15.3%);
    -webkit-mask-size: contain, 100% 100%;
    mask-size: contain, 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }
  .plus.a {
    top: -7px;
    right: 18%;
  }
  .plus.b {
    bottom: 6%;
    left: -7px;
  }
  .note {
    position: absolute;
    padding: 0.35rem 0.6rem;
    background: var(--bg);
    font-size: 0.7rem;
    line-height: 1.5;
    color: var(--fg);
  }
  .n1 {
    top: 8%;
    left: -1.5rem;
    border-top: 2px solid var(--fg);
  }
  .n2 {
    right: -0.5rem;
    top: 34%;
    border-left: 2px solid var(--accent);
  }
  @media (max-width: 640px) {
    .n1 {
      left: 0;
    }
    .n2 {
      right: 0;
    }
  }
</style>
