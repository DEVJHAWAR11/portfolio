---
// My photo as halftone dots (built by /halftone.svg, and /halftone-dark.svg for the dark theme). The dots are a CSS
// mask, so they take the theme's colours.
// With motion allowed, src/lib/portrait.ts redraws them on a canvas: they gather out of the page's dot grid once a
// session and lean away from the cursor. The mask copy stays underneath as the fallback, and is all that a lite device
// (src/lib/lite.ts) shows until someone points at it.
---

<div class="portrait" data-portrait role="img" aria-label="Portrait of Dev Jhawar, drawn in dots">
  <div class="layer ink"></div>
  <span class="plus a" aria-hidden="true"></span>
  <span class="plus b" aria-hidden="true"></span>
  <span class="mono note n1" aria-hidden="true">Agents<br />Retrieval<br />Backend</span>
  <span class="mono note n2" aria-hidden="true">Plan<br />Search<br />Cite<br />Ship</span>
</div>
<!-- Before paint: if the dots are about to gather, hide the still copy so it doesn't flash first. -->
<script is:inline>
  (function () {
    var el = document.currentScript.previousElementSibling;
    try {
      var n = navigator;
      var lite = (n.connection && n.connection.saveData) || (n.deviceMemory || 8) < 4 || (n.hardwareConcurrency || 8) < 4;
      if (!lite && !matchMedia('(prefers-reduced-motion: reduce)').matches && !sessionStorage.getItem('portrait-built'))
        el.dataset.assemble = '';
    } catch (e) {}
  })();
</script>

<script>
  import { livePortrait } from '@/lib/portrait';
  import { lite } from '@/lib/lite';
  const el = document.querySelector<HTMLElement>('[data-portrait]');
  if (el && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    if (lite) el.addEventListener('pointerenter', () => livePortrait(el), { once: true });
    else livePortrait(el);
  }
</script>

<style>
  .portrait {
    position: relative;
    aspect-ratio: 1;
  }
  .layer {
    position: absolute;
    inset: 0;
    -webkit-mask: url('/halftone.svg') center / contain no-repeat;
    mask: url('/halftone.svg') center / contain no-repeat;
  }
  .ink {
    background: var(--fg);
  }
  :global([data-theme='dark']) .layer {
    -webkit-mask-image: url('/halftone-dark.svg');
    mask-image: url('/halftone-dark.svg');
  }
  .portrait:global(.live) .ink,
  .portrait[data-assemble] .ink {
    visibility: hidden;
  }
  .portrait :global(canvas.live) {
    position: absolute;
    inset: -10%;
    width: 120%;
    height: 120%;
    pointer-events: none;
  }
  .plus.a {
    top: -7px;
    right: 18%;
  }
  .plus.b {
    bottom: 6%;
    left: -7px;
  }
  .note {
    position: absolute;
    padding: 0.35rem 0.6rem;
    background: var(--bg);
    font-size: 0.7rem;
    line-height: 1.5;
    color: var(--fg);
  }
  .n1 {
    top: 8%;
    left: -1.5rem;
    border-top: 2px solid var(--fg);
  }
  .n2 {
    right: -0.5rem;
    top: 34%;
    border-left: 2px solid var(--accent);
  }
  @media (max-width: 640px) {
    /* The canvas reaches past the box; on a phone the box is nearly full width, so keep it from widening the page. */
    .portrait {
      overflow-x: clip;
    }
    .plus.b {
      left: 0;
    }
    .n1 {
      left: 0;
    }
    .n2 {
      right: 0;
    }
  }
</style>
