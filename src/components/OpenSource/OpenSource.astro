---
// Contribution map and pull requests to other people's repos.
// Rendered from a build-time snapshot, then refreshed from /api/github (cached for an hour) when that is newer.
import { getGitHub } from '@/lib/github';
import { heatmap, prGroups, packCals, total } from '@/lib/oss-render';
import Pending from '@/components/Pending/Pending.astro';

const { prs, cals, at } = await getGitHub();
const first = cals[0];
const counts = { merged: 0, open: 0, closed: 0 };
prs.forEach((p) => counts[p.state]++);
const filters = [['all', 'All', prs.length], ...Object.entries(counts).map(([k, n]) => [k, k === 'open' ? 'In review' : k[0].toUpperCase() + k.slice(1), n])].filter(
  ([k, , n]) => k !== 'closed' || (n as number) > 0,
) as [string, string, number][];
const repos = new Set(prs.map((p) => p.repo)).size;
// Colour sets for the map. Each sets four shades, from a quiet day to the busiest.
const palettes = [
  ['ink', 'Ink'],
  ['grass', 'Grass'],
  ['ember', 'Ember'],
  ['ocean', 'Ocean'],
  ['candy', 'Candy'],
];
---

<div class="oss" data-oss data-at={at} data-cals={packCals(cals)}>
  {
    first && (
      <div class="blk activity">
        <div class="ahead">
          <div class="years mono" role="group" aria-label="Which year" data-years>
            {cals.map((c, i) => (
              <button type="button" data-y={c.id} aria-pressed={i === 0 ? 'true' : 'false'}>
                {c.label} <span>{total(c.days).toLocaleString('en-IN')}</span>
              </button>
            ))}
          </div>
          <div class="acts">
            <div class="heat" role="group" aria-label="Map colours">
              {palettes.map(([id, name], i) => (
                <button type="button" data-heat={id} aria-pressed={i === 0 ? 'true' : 'false'} title={name} aria-label={`${name} colours`}>
                  <i />
                  <i />
                  <i />
                  <i />
                </button>
              ))}
            </div>
            <div class="play">
              <button type="button" class="btn sm" data-replay>
                Replay
              </button>
              <button type="button" class="btn sm pacbtn" data-pac>
              <svg viewBox="-6 -6 12 12" width="13" height="13" aria-hidden="true">
                <path d="M0 0 L4.6 2.7 A5.3 5.3 0 1 1 4.6 -2.7 Z" fill="currentColor" />
              </svg>
                <span class="w">Play</span> Pac-Man
              </button>
            </div>
          </div>
        </div>
        <div class="map" data-map data-heat="ink" set:html={heatmap(first.days)} />
        <p class="mono cap" data-cap aria-live="polite">
          Each dot is a day. Bigger dots mean more commits, PRs and reviews.
        </p>
      </div>
    )
  }

  {prs.length === 0 && <div data-pending><Pending what="pull requests across other repos, live from GitHub" stage={4} /></div>}
  <div data-prwrap hidden={prs.length === 0}>
    <div class="prhead">
      <div class="filters" role="group" aria-label="Filter pull requests">
        {
          filters.map(([k, label, n], i) => (
            <button type="button" class:list={['chip', k]} data-f={k} aria-pressed={i === 0 ? 'true' : 'false'}>
              {k !== 'all' && <span class:list={['dot', { ok: k === 'merged', pend: k === 'open', fail: k === 'closed' }]} />}
              {label} <span class="n">{n}</span>
            </button>
          ))
        }
      </div>
      <p class="mono checked">
        <span data-repos>{repos}</span> repos. Checked GitHub <span data-ago>at build time</span>
      </p>
    </div>
    <ul class="prs" data-prs set:html={prGroups(prs)} />
  </div>
</div>

<script>
  import { heatmap, prGroups, packCals, unpackCals, dayLabel, total } from '@/lib/oss-render';
  import { pacman } from '@/lib/pacman';
  import type { Cal, Day, GitHubData, PR } from '@/lib/github';

  const root = document.querySelector<HTMLElement>('[data-oss]');
  if (root) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s);
    const map = $('[data-map]');
    const cap = $('[data-cap]');
    const list = $('[data-prs]');
    const capText = cap?.textContent ?? '';
    const say = (t: string) => cap && (cap.textContent = t);
    let filter = 'all';
    // Replay and Pac-Man both draw on the map, so only one runs at a time and the year stays put meanwhile.
    let busy = false;

    let cals: Cal[] = unpackCals(root.dataset.cals!);
    let year = cals[0]?.id;
    let days: Day[] = cals[0]?.days ?? [];
    if (map) map.scrollLeft = map.scrollWidth;
    const yearName = () => (year === 'past' ? 'the past year' : year);

    function showYear(id: string) {
      const c = cals.find((x) => x.id === id) ?? cals[0];
      if (!c || !map) return;
      year = c.id;
      days = c.days;
      map.innerHTML = heatmap(c.days, c.id === 'past' ? 'the past year' : c.label);
      map.scrollLeft = map.scrollWidth;
      root!.querySelectorAll<HTMLElement>('[data-y]').forEach((b) => {
        b.setAttribute('aria-pressed', String(b.dataset.y === c.id));
        b.querySelector('span')!.textContent = total(cals.find((x) => x.id === b.dataset.y)?.days ?? []).toLocaleString('en-IN');
      });
    }
    root.querySelectorAll<HTMLButtonElement>('[data-y]').forEach((b) => b.addEventListener('click', () => !busy && showYear(b.dataset.y!)));

    // Colour sets, remembered for the next visit.
    const heatBtns = root.querySelectorAll<HTMLButtonElement>('.heat [data-heat]');
    function setHeat(id: string) {
      if (!map || ![...heatBtns].some((b) => b.dataset.heat === id)) return;
      map.dataset.heat = id;
      heatBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.heat === id)));
      try {
        localStorage.setItem('heat', id);
      } catch {}
    }
    heatBtns.forEach((b) => b.addEventListener('click', () => setHeat(b.dataset.heat!)));
    try {
      setHeat(localStorage.getItem('heat') ?? 'ink');
    } catch {}

    // Hovering or tapping a dot names that day in the caption.
    map?.addEventListener('pointerover', (e) => {
      const i = (e.target as Element).getAttribute('data-i');
      if (i && !busy) say(dayLabel(days[Number(i)]));
    });
    map?.addEventListener('pointerleave', () => !busy && say(capText));

    const replay = $<HTMLButtonElement>('[data-replay]');
    const pac = $<HTMLButtonElement>('[data-pac]');
    const lock = (on: boolean) => {
      busy = on;
      if (replay) replay.disabled = on;
      if (pac) pac.disabled = on;
    };

    // Replay fills the year in week by week while the total counts up.
    replay?.addEventListener('click', async () => {
      const dots = [...map!.querySelectorAll<SVGCircleElement>('circle')];
      const weeks = Number(dots.at(-1)?.dataset.w ?? 0) + 1;
      lock(true);
      map!.classList.add('replay');
      let sum = 0;
      for (let w = 0; w < weeks; w++) {
        for (const c of dots) {
          if (Number(c.dataset.w) !== w) continue;
          c.classList.add('on');
          sum += days[Number(c.dataset.i)].n;
        }
        say(`Week ${w + 1} of ${weeks}: ${sum.toLocaleString('en-IN')} contributions so far`);
        if (!reduce) await new Promise((r) => setTimeout(r, 45));
      }
      map!.classList.remove('replay');
      dots.forEach((c) => c.classList.remove('on'));
      say(capText);
      lock(false);
    });

    // Pac-Man eats the year column by column; the score is the contributions on the days he eats.
    pac?.addEventListener('click', async () => {
      const svg = map?.querySelector('svg');
      if (!svg) return;
      lock(true);
      map!.scrollLeft = 0;
      const { score, ms } = await pacman(svg, days, (n) => {
        say(`Score ${n.toLocaleString('en-IN')}`);
        const head = svg.querySelector<SVGGElement>('.pac');
        // Keep him in view when the map scrolls sideways on a phone.
        if (head && map!.scrollWidth > map!.clientWidth) {
          const x = head.getBoundingClientRect().left - map!.getBoundingClientRect().left;
          if (x > map!.clientWidth * 0.6) map!.scrollLeft += x - map!.clientWidth * 0.6;
        }
      });
      say(`Game over. Pac-Man ate ${score.toLocaleString('en-IN')} contributions from ${yearName()} in ${(ms / 1000).toFixed(1)} s.`);
      lock(false);
    });

    // Filters hide PRs, and a repo with none left hides too.
    function applyFilter() {
      if (!list) return;
      let shown = 0;
      list.querySelectorAll<HTMLElement>('[data-repo]').forEach((card) => {
        let any = false;
        card.querySelectorAll<HTMLElement>('.track > li').forEach((r) => {
          const m = filter === 'all' || r.dataset.state === filter;
          r.hidden = !m;
          any ||= m;
        });
        card.hidden = !any;
        shown += Number(any);
      });
      const n = $('[data-repos]');
      if (n) n.textContent = String(shown);
    }
    root.querySelectorAll<HTMLButtonElement>('[data-f]').forEach((b) =>
      b.addEventListener('click', () => {
        filter = b.dataset.f!;
        root.querySelectorAll('[data-f]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        applyFilter();
      }),
    );
    applyFilter();

    const agoEl = $('[data-ago]');
    const showAge = () => {
      if (!agoEl) return;
      const min = Math.round((Date.now() - Date.parse(root.dataset.at!)) / 6e4);
      agoEl.textContent =
        min < 1 ? 'just now' : min < 60 ? `${min} min ago` : min < 48 * 60 ? `${Math.round(min / 60)} h ago` : `${Math.round(min / 1440)} days ago`;
    };
    showAge();
    setInterval(showAge, 6e4);

    function update(g: GitHubData) {
      if (g.cals?.length && map && !busy) {
        cals = g.cals;
        root!.dataset.cals = packCals(g.cals);
        showYear(year);
      }
      if (g.prs.length && list) {
        $('[data-pending]')?.remove();
        $('[data-prwrap]')!.hidden = false;
        list.innerHTML = prGroups(g.prs);
        const counts: Record<string, number> = { all: g.prs.length, merged: 0, open: 0, closed: 0 };
        g.prs.forEach((p: PR) => counts[p.state]++);
        root!.querySelectorAll<HTMLElement>('[data-f]').forEach((b) => (b.querySelector('.n')!.textContent = String(counts[b.dataset.f!])));
        applyFilter();
      }
      root!.dataset.at = g.at;
      showAge();
    }

    // The function only exists once deployed on Vercel; anywhere else this quietly keeps the build-time snapshot.
    const refresh = () =>
      fetch('/api/github')
        .then((r) => (r.ok && r.headers.get('content-type')?.includes('json') ? r.json() : null))
        .then((g: GitHubData | null) => g && Date.parse(g.at) > Date.parse(root.dataset.at!) && update(g))
        .catch(() => {});
    ('requestIdleCallback' in window ? requestIdleCallback : setTimeout)(refresh as () => void);
  }
</script>

<style>
  .activity {
    margin-bottom: 2.5rem;
    padding: 1.1rem 1.25rem 1rem;
  }
  .ahead {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.7rem 1rem;
    margin-bottom: 0.9rem;
  }
  .acts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  /* Colours, Replay and Pac-Man share one line; on a phone everything tightens up to fit it. */
  .play {
    display: flex;
    gap: 0.5rem;
  }
  @media (max-width: 480px) {
    .acts {
      flex-wrap: nowrap;
      gap: 0.4rem;
    }
    .acts .heat {
      gap: 0;
      margin-right: 0;
    }
    .acts .heat button {
      padding: 4px;
    }
    .play {
      gap: 0.4rem;
    }
    .play .btn {
      padding: 0 0.6rem;
    }
    .pacbtn .w {
      display: none;
    }
  }
  @media (max-width: 360px) {
    .acts .heat button {
      padding: 3px;
    }
    .pacbtn svg {
      display: none;
    }
  }
  @media (max-width: 420px) {
    .ahead .years button {
      padding: 0.4rem 0.55rem;
      font-size: 0.72rem;
    }
  }
  .cap {
    margin: 0.7rem 0 0;
    min-height: 1.3em;
    color: var(--muted);
  }
  .years {
    display: flex;
    flex-wrap: wrap;
    border: 1px solid var(--edge);
  }
  .years button {
    padding: 0.4rem 0.75rem;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .years button + button {
    border-left: 1px solid var(--edge);
  }
  .years button:hover {
    color: var(--fg);
  }
  .years button span {
    margin-left: 0.3rem;
    color: var(--faint);
  }
  .years button[aria-pressed='true'] {
    background: var(--fg);
    color: var(--bg);
  }
  .years button[aria-pressed='true'] span {
    color: inherit;
    opacity: 0.6;
  }

  /* Colour sets. Light and dark get their own shades so the quiet days never vanish into the panel. */
  [data-heat='ink'] {
    --h1: color-mix(in srgb, var(--accent) 40%, var(--panel));
    --h2: color-mix(in srgb, var(--accent) 62%, var(--panel));
    --h3: color-mix(in srgb, var(--accent) 82%, var(--panel));
    --h4: var(--accent);
  }
  [data-heat='grass'] {
    --h1: #9be9a8;
    --h2: #40c463;
    --h3: #30a14e;
    --h4: #216e39;
  }
  [data-heat='ember'] {
    --h1: #fdcf8f;
    --h2: #fb9a4b;
    --h3: #ec5f2a;
    --h4: #c22a1a;
  }
  [data-heat='ocean'] {
    --h1: #a9dcf5;
    --h2: #55b2e3;
    --h3: #1d82c4;
    --h4: #0b4c86;
  }
  [data-heat='candy'] {
    --h1: #f6c2de;
    --h2: #ee86bd;
    --h3: #d64a98;
    --h4: #95186a;
  }
  :global([data-theme='dark']) [data-heat='grass'] {
    --h1: #0e4429;
    --h2: #006d32;
    --h3: #26a641;
    --h4: #39d353;
  }
  :global([data-theme='dark']) [data-heat='ember'] {
    --h1: #5a2610;
    --h2: #a3431b;
    --h3: #e7702b;
    --h4: #ffb54d;
  }
  :global([data-theme='dark']) [data-heat='ocean'] {
    --h1: #0c3552;
    --h2: #0f6299;
    --h3: #2b9de2;
    --h4: #8ed6ff;
  }
  :global([data-theme='dark']) [data-heat='candy'] {
    --h1: #4c1636;
    --h2: #8c2566;
    --h3: #d2489b;
    --h4: #ff9cd6;
  }
  .heat {
    display: flex;
    gap: 0.25rem;
    margin-right: 0.3rem;
  }
  .heat button {
    display: grid;
    grid-template-columns: repeat(2, 5px);
    gap: 2px;
    padding: 5px;
    border: 1px solid transparent;
  }
  .heat button:hover {
    border-color: var(--edge);
  }
  .heat button[aria-pressed='true'] {
    border-color: var(--fg);
  }
  .heat i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--h1);
  }
  .heat i:nth-child(2) {
    background: var(--h2);
  }
  .heat i:nth-child(3) {
    background: var(--h3);
  }
  .heat i:nth-child(4) {
    background: var(--h4);
  }
  .pacbtn {
    gap: 0.45rem;
  }
  .pacbtn svg {
    color: #e8b400;
  }

  /* On a phone the year keeps a readable size and scrolls sideways, starting at the latest weeks. */
  .map {
    overflow-x: auto;
    scrollbar-width: thin;
  }
  .map :global(svg) {
    display: block;
    width: 100%;
    min-width: 34rem;
    height: auto;
  }
  .map :global(text) {
    font: 400 7px var(--mono);
    fill: var(--faint);
  }
  .map :global(circle) {
    transition: opacity 0.15s, fill 0.3s;
  }
  .map :global(circle.l0) {
    fill: var(--faint);
    opacity: 0.4;
  }
  .map :global(circle.l1) {
    fill: var(--h1);
  }
  .map :global(circle.l2) {
    fill: var(--h2);
  }
  .map :global(circle.l3) {
    fill: var(--h3);
  }
  .map :global(circle.l4) {
    fill: var(--h4);
  }
  .map :global(circle:hover) {
    fill: var(--fg);
    opacity: 1;
  }
  .map:global(.replay) :global(circle:not(.on)) {
    opacity: 0;
  }
  .map :global(circle.eaten) {
    opacity: 0;
    transition: none;
  }

  .prhead {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.8rem 1.5rem;
    margin-bottom: 1rem;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .filters .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--panel);
    cursor: pointer;
  }
  .filters .chip:hover {
    border-color: var(--fg);
    color: var(--fg);
  }
  .filters .chip[aria-pressed='true'] {
    border-color: var(--fg);
    background: var(--fg);
    color: var(--bg);
  }
  .filters .n {
    opacity: 0.65;
  }
  .checked {
    margin: 0;
    color: var(--faint);
  }

  /* One card per repo, flowing into two columns. */
  .prs {
    margin: 0;
    padding: 0;
    list-style: none;
    columns: 2 24rem;
    column-gap: 1rem;
  }
  .prs :global(.repo) {
    break-inside: avoid;
    margin-bottom: 1rem;
    border: 1px solid var(--edge);
    background: var(--panel);
  }
  .prs :global([hidden]) {
    display: none;
  }
  .prs :global(.rh) {
    display: grid;
    grid-template-columns: 30px minmax(0, 1fr);
    gap: 0.1rem 0.8rem;
    align-items: center;
    padding: 0.9rem 1.1rem 0.6rem;
  }
  .prs :global(.rh img) {
    grid-row: span 2;
    border: 1px solid var(--edge);
    background: var(--bg);
  }
  .prs :global(.name) {
    font-size: 0.9rem;
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .prs :global(.name span) {
    font-weight: 400;
    color: var(--faint);
  }
  .prs :global(.name:hover) {
    color: var(--accent);
  }
  .prs :global(.tally) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.68rem;
    color: var(--muted);
  }
  .prs :global(.bar) {
    display: flex;
    gap: 2px;
    width: 3.2rem;
    height: 4px;
  }
  .prs :global(.bar i) {
    background: var(--ok);
  }
  .prs :global(.bar .pend) {
    background: var(--pend);
  }
  .prs :global(.bar .fail) {
    background: var(--fail);
  }

  /* The repo's line, with a stop for each PR. */
  .prs :global(.track) {
    position: relative;
    margin: 0;
    padding: 0 0 0.5rem;
    list-style: none;
  }
  .prs :global(.track)::before {
    content: '';
    position: absolute;
    left: calc(1.1rem + 4.25px);
    top: 0.2rem;
    bottom: 1.4rem;
    width: 1.5px;
    background: var(--edge);
  }
  .prs :global(.track li) {
    --c: var(--ok);
  }
  .prs :global(.track li[data-state='open']) {
    --c: var(--pend);
  }
  .prs :global(.track li[data-state='closed']) {
    --c: var(--fail);
  }
  .prs :global(.track a) {
    display: grid;
    grid-template-columns: 10px minmax(0, 1fr);
    gap: 0.1rem 0.9rem;
    padding: 0.45rem 1.1rem;
    transition: background 0.2s;
  }
  .prs :global(.track a:hover) {
    background: var(--accent-soft);
  }
  .prs :global(.stop) {
    position: relative;
    width: 10px;
    height: 10px;
    margin-top: 0.42em;
    border-radius: 50%;
    background: var(--c);
  }
  .prs :global(li[data-state='open'] .stop) {
    background: var(--panel);
    border: 2px solid var(--c);
    animation: wait 2s ease-in-out infinite;
  }
  .prs :global(li[data-state='closed'] .stop) {
    border-radius: 0;
    background: var(--panel);
    rotate: 45deg;
  }
  .prs :global(li[data-state='closed'] .stop)::before,
  .prs :global(li[data-state='closed'] .stop)::after {
    content: '';
    position: absolute;
    inset: 4px 0;
    background: var(--c);
  }
  .prs :global(li[data-state='closed'] .stop)::after {
    inset: 0 4px;
  }
  @keyframes wait {
    50% {
      box-shadow: 0 0 0 4px color-mix(in srgb, var(--pend) 25%, transparent);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .prs :global(.stop) {
      animation: none !important;
    }
  }
  .prs :global(.t) {
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.4;
  }
  .prs :global(.track a:hover .t) {
    color: var(--accent);
  }
  .prs :global(.m) {
    grid-column: 2;
    font-size: 0.68rem;
    color: var(--faint);
  }
  .prs :global(.num) {
    margin-right: 0.3rem;
    color: var(--muted);
  }
</style>
