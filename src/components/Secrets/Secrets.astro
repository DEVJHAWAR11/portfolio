---
// The logo's easter egg: click it five times and a small console prints a few confessions.
import profile from '@/data/profile.json';

const secrets = [
  'I overthink system design at 2 am.',
  'Coffee makes everything possible.',
  "I break things while trying to make them better, then I write a test so it can't happen twice.",
  'I read the source when the docs run out.',
  "I've lost arguments to a compiler. It was right every time.",
  'I explain bugs to an empty room. It works more often than it should.',
  "Red tests don't scare me. Silent failures do.",
  'Most of my best ideas showed up in the shower, not at the desk.',
  'When something works first try, I get suspicious.',
];
---

<div class="secrets" id="secrets" role="dialog" aria-labelledby="secrets-title" hidden data-secrets={JSON.stringify(secrets)} data-email={profile.email}>
  <div class="tb mono">
    <span id="secrets-title"><i class="dot ok"></i>dev@jhawar: ~/secrets</span>
    <button type="button" class="snd" data-sound aria-pressed="true">sound on</button>
    <button type="button" class="x" data-close aria-label="Close the secrets console">
      <svg viewBox="0 0 12 12" width="11" height="11" aria-hidden="true"><path d="m2 2 8 8M10 2l-8 8" stroke="currentColor" stroke-width="1.6" /></svg>
    </button>
  </div>
  <div class="out mono" data-out aria-live="polite"></div>
</div>

<script>
  import { sfx, soundOn, setSound } from '@/lib/sfx';
  import { unlock } from '@/lib/eggs';

  const box = document.getElementById('secrets');
  if (box) {
    const out = box.querySelector<HTMLElement>('[data-out]')!;
    const snd = box.querySelector<HTMLButtonElement>('[data-sound]')!;
    const secrets: string[] = JSON.parse(box.dataset.secrets!);
    const email = box.dataset.email!;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let run = 0; // bumps on every open or close, so an old typing loop stops
    let skip = false;
    let opener: HTMLElement | null = null;

    const syncSound = () => {
      const on = soundOn();
      snd.textContent = on ? 'sound on' : 'sound off';
      snd.setAttribute('aria-pressed', String(on));
    };
    syncSound();
    document.addEventListener('sound', syncSound);
    snd.addEventListener('click', () => {
      setSound(!soundOn());
      sfx.toggle();
    });

    const wait = (ms: number) => new Promise((r) => setTimeout(r, skip || still ? 0 : ms));
    const down = () => (out.scrollTop = out.scrollHeight);
    const line = (cls: string, text = '') => {
      const p = document.createElement('p');
      p.className = cls;
      p.textContent = text;
      out.append(p);
      down();
      return p;
    };
    async function type(p: HTMLElement, text: string, id: number) {
      for (const ch of text) {
        if (id !== run) return;
        p.textContent += ch;
        down();
        await wait(28);
      }
    }
    async function cmd(text: string, id: number) {
      const p = line('cmd');
      await type(p, text, id);
      await wait(260);
    }

    async function play() {
      const id = ++run;
      skip = false;
      out.textContent = '';
      await wait(250);
      await cmd('cat secrets.log', id);
      for (const [i, s] of secrets.entries()) {
        if (id !== run) return;
        const p = line('sec');
        p.innerHTML = `<span>${String(i + 1).padStart(2, '0')}</span>`;
        p.append(s);
        down();
        sfx.line();
        await wait(520);
      }
      if (id !== run) return;
      await cmd('whoami --still-here', id);
      if (id !== run) return;
      line('end', "Still reading? Then you're curious. So am I. Let's talk.");
      sfx.line();
      await wait(400);
      if (id !== run) return;
      const p = line('cmd mail');
      const a = document.createElement('a');
      a.href = `mailto:${email}?subject=${encodeURIComponent('Found your secrets')}`;
      a.textContent = `mail ${email}`;
      p.append(a, Object.assign(document.createElement('i'), { className: 'cur' }));
      down();
      unlock('secrets');
    }

    function open(from?: HTMLElement) {
      opener = from ?? null;
      if (!box!.hidden) return play();
      box!.hidden = false;
      sfx.open();
      box!.querySelector<HTMLButtonElement>('[data-close]')!.focus({ preventScroll: true });
      play();
    }
    function close() {
      if (box!.hidden) return;
      run++;
      box!.hidden = true;
      sfx.close();
      opener?.focus({ preventScroll: true });
    }
    box.querySelector('[data-close]')!.addEventListener('click', close);
    box.addEventListener('keydown', (e) => e.key === 'Escape' && close());
    // A click inside the output finishes the typing at once.
    out.addEventListener('click', (e) => !(e.target as Element).closest('a') && (skip = true));
    document.addEventListener('secrets', (e) => open((e as CustomEvent<HTMLElement>).detail));
  }
</script>

<style>
  .secrets {
    position: absolute;
    top: calc(100% + 0.6rem);
    left: 0;
    width: min(27rem, 100%);
    border: 1px solid var(--fg);
    background: var(--panel);
    box-shadow: 6px 6px 0 color-mix(in srgb, var(--fg) 12%, transparent);
    animation: pop 0.22s var(--ease);
  }
  .secrets[hidden] {
    display: none;
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  .tb {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0 0.3rem 0 0.75rem;
    height: 2.2rem;
    border-bottom: 1px solid var(--edge);
    font-size: 0.72rem;
    color: var(--muted);
  }
  .tb > span {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .snd {
    padding: 0.2rem 0.45rem;
    border: 1px solid var(--edge);
    font-size: 0.66rem;
    color: var(--muted);
    white-space: nowrap;
  }
  .snd:hover,
  .x:hover {
    color: var(--fg);
    border-color: var(--fg);
  }
  .snd[aria-pressed='false'] {
    color: var(--faint);
    text-decoration: line-through;
  }
  .x {
    display: grid;
    place-items: center;
    width: 1.7rem;
    height: 1.7rem;
    border: 1px solid transparent;
    color: var(--muted);
  }
  .out {
    max-height: min(52vh, 21rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.8rem 0.9rem 0.9rem;
    font-size: 0.78rem;
    line-height: 1.55;
  }
  .out :global(p) {
    margin: 0 0 0.3rem;
  }
  .out :global(.cmd)::before {
    content: '$ ';
    color: var(--accent);
  }
  .out :global(.cmd) {
    margin-top: 0.15rem;
    color: var(--muted);
  }
  .out :global(.sec) {
    display: grid;
    grid-template-columns: 1.8rem 1fr;
    animation: in 0.3s var(--ease);
  }
  .out :global(.sec span) {
    color: var(--faint);
  }
  .out :global(.end) {
    margin-top: 0.6rem;
    color: var(--fg);
    font-weight: 600;
    animation: in 0.3s var(--ease);
  }
  .out :global(.mail a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    word-break: break-all;
  }
  .out :global(.cur) {
    display: inline-block;
    width: 0.5em;
    height: 1em;
    margin-left: 0.3em;
    vertical-align: -0.15em;
    background: var(--accent);
    animation: blink 1s steps(1) infinite;
  }
  @keyframes in {
    from {
      opacity: 0;
      transform: translateX(-4px);
    }
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .secrets,
    .out :global(.sec),
    .out :global(.end),
    .out :global(.cur) {
      animation: none;
    }
  }
</style>
