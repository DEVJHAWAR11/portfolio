---
// CaseCompass's merge step on its own: two ranked lists in, one fused list out, with k on a slider.
// The cases are made-up examples written for this demo, not real judgments.
const cases: Record<string, string> = {
  A: 'Flight cancelled, airline refused refund, refund ordered with interest',
  B: 'Rescheduled flight, passenger missed connection, compensation awarded',
  C: 'Refund delayed eight months after cancellation, deficiency in service',
  D: 'Airline offered only a credit shell instead of a refund',
  E: 'Lost baggage on a domestic flight, partial compensation',
  F: 'Overbooked flight, denied boarding, complaint dismissed',
  G: 'Travel agent kept the refund for a cancelled ticket',
  H: 'Train ticket cancelled, refund refused under railway rules',
};
const meaning = ['A', 'B', 'C', 'D', 'E', 'F'];
const keyword = ['G', 'C', 'D', 'A', 'H', 'B'];
const all = Object.keys(cases);
---

<div class="demo rrf" data-rrf data-meaning={meaning.join('')} data-keyword={keyword.join('')}>
  <div class="top">
    <p class="query"><span class="mono lbl">Story</span> “My flight was cancelled and the airline won't refund me.”</p>
    <label class="k">
      <span class="mono">k = <b id="r-k">60</b></span>
      <input id="r-range" type="range" min="1" max="100" value="60" aria-label="RRF constant k" />
    </label>
  </div>

  <div class="cols">
    <section>
      <h4 class="mono">Meaning search <span>vectors</span></h4>
      <ol>
        {
          meaning.map((id, i) => (
            <li data-id={id}>
              <span class="rk mono">{i + 1}</span>
              <span class="id mono">{id}</span>
              <span class="txt">{cases[id]}</span>
            </li>
          ))
        }
      </ol>
    </section>
    <section>
      <h4 class="mono">Keyword search <span>tsvector</span></h4>
      <ol>
        {
          keyword.map((id, i) => (
            <li data-id={id}>
              <span class="rk mono">{i + 1}</span>
              <span class="id mono">{id}</span>
              <span class="txt">{cases[id]}</span>
            </li>
          ))
        }
      </ol>
    </section>
    <section class="fused">
      <h4 class="mono">
        Fused with RRF
        <span class="lg"><i class="m"></i>meaning <i class="kw"></i>keyword</span>
      </h4>
      <ol id="r-out" style={`height: calc(${all.length} * var(--row))`}>
        {
          all.map((id) => (
            <li data-id={id}>
              <span class="rk mono" />
              <span class="id mono">{id}</span>
              <span class="bar" aria-hidden="true">
                <span class="m" />
                <span class="kw" />
              </span>
              <span class="sc mono" />
            </li>
          ))
        }
      </ol>
    </section>
  </div>

  <p class="note">
    Each case scores <code>1/(k + rank)</code> from every list it appears in, and the scores add up. A small k trusts
    each list's top pick, so <b>G</b>, first in keyword search only, rises. A large k rewards cases both searches agree
    on, so <b>D</b> climbs past it. 60 is the usual default. Hover a case to find it in every list.
  </p>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-rrf]');
  if (root) {
    const meaning = [...root.dataset.meaning!];
    const keyword = [...root.dataset.keyword!];
    const range = root.querySelector<HTMLInputElement>('#r-range')!;
    const kOut = root.querySelector('#r-k')!;
    const rows = [...root.querySelectorAll<HTMLLIElement>('#r-out li')];

    function render() {
      const k = Number(range.value);
      kOut.textContent = String(k);
      const part = (list: string[], id: string) => (list.includes(id) ? 1 / (k + list.indexOf(id) + 1) : 0);
      const scored = rows
        .map((li) => {
          const id = li.dataset.id!;
          const m = part(meaning, id);
          const kw = part(keyword, id);
          return { li, m, kw, s: m + kw };
        })
        .sort((a, b) => b.s - a.s);
      const top = scored[0].s;
      scored.forEach(({ li, m, kw, s }, i) => {
        li.style.transform = `translateY(calc(${i} * var(--row)))`;
        li.querySelector('.rk')!.textContent = String(i + 1);
        li.querySelector('.sc')!.textContent = s.toFixed(4);
        li.querySelector<HTMLElement>('.m')!.style.width = `${(m / top) * 100}%`;
        li.querySelector<HTMLElement>('.kw')!.style.width = `${(kw / top) * 100}%`;
      });
    }

    // Hovering a case lights it up in all three lists.
    root.addEventListener('pointerover', (e) => {
      const id = (e.target as Element).closest<HTMLElement>('[data-id]')?.dataset.id;
      root.querySelectorAll<HTMLElement>('[data-id]').forEach((li) => li.classList.toggle('on', li.dataset.id === id));
    });
    root.addEventListener('pointerleave', () => root.querySelectorAll('.on').forEach((li) => li.classList.remove('on')));

    range.addEventListener('input', render);
    render();
  }
</script>

<style>
  .rrf {
    --row: 2.6rem;
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem 2rem;
    padding: 1.1rem 1.25rem;
    border-bottom: 1px solid var(--edge);
  }
  .query {
    margin: 0;
    font-size: 1.05rem;
  }
  .lbl {
    margin-right: 0.6rem;
    color: var(--muted);
  }
  .k {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }
  .k b {
    display: inline-block;
    min-width: 2ch;
    color: var(--accent);
  }
  input[type='range'] {
    width: 11rem;
    accent-color: var(--accent);
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  section {
    padding: 1rem 1.25rem 1.2rem;
  }
  section + section {
    border-left: 1px solid var(--edge);
  }
  h4 {
    margin: 0 0 0.6rem;
    font-weight: 500;
    color: var(--fg);
  }
  h4 span {
    color: var(--faint);
    margin-left: 0.4rem;
  }
  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    display: grid;
    grid-template-columns: 1.3rem 1.6rem minmax(0, 1fr);
    align-items: center;
    gap: 0.4rem;
    height: var(--row);
    border-top: 1px solid var(--line);
    transition: background 0.15s;
  }
  .rk {
    color: var(--faint);
  }
  .id {
    display: grid;
    place-items: center;
    width: 1.4rem;
    height: 1.4rem;
    border: 1px solid var(--edge);
    font-weight: 600;
  }
  .txt {
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    font-size: 0.78rem;
    line-height: 1.3;
    color: var(--muted);
  }
  li.on {
    background: var(--accent-soft);
  }
  li.on .id {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }
  .fused ol {
    position: relative;
  }
  .fused li {
    position: absolute;
    inset: 0 0 auto;
    grid-template-columns: 1.3rem 1.6rem minmax(0, 1fr) 3.6rem;
    transition: transform 0.45s var(--ease), background 0.15s;
  }
  .lg i {
    display: inline-block;
    width: 0.55rem;
    height: 0.55rem;
    margin: 0 0.25rem 0 0.5rem;
  }
  .m {
    background: var(--fg);
  }
  .kw {
    background: var(--accent);
  }
  .bar {
    display: flex;
    height: 0.6rem;
    background: var(--line);
  }
  .bar span {
    transition: width 0.3s var(--ease);
  }
  .sc {
    text-align: right;
    font-size: 0.72rem;
    color: var(--muted);
  }
  .note {
    margin: 0;
    padding: 0.9rem 1.25rem 1.1rem;
    border-top: 1px solid var(--edge);
    font-size: 0.88rem;
    color: var(--muted);
  }
  .note code {
    font: 0.92em var(--mono);
    color: var(--fg);
  }
  .note b {
    color: var(--fg);
  }
  @media (max-width: 860px) {
    .cols {
      grid-template-columns: 1fr 1fr;
    }
    /* The fused list moves up under the slider, so dragging k changes something on screen. */
    .fused {
      order: -1;
      grid-column: 1 / -1;
      border-left: 0;
      border-bottom: 1px solid var(--edge);
    }
  }
  @media (max-width: 560px) {
    .cols {
      grid-template-columns: 1fr;
    }
    section + section {
      border-left: 0;
      border-top: 1px solid var(--edge);
    }
    .fused {
      border-top: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .fused li {
      transition: none;
    }
  }
</style>
